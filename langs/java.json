{
  "id": "java",
  "test_files": [
    "src/test/**",
    "*Test.java",
    "*Tests.java",
    "*IT.java"
  ],
  "build_output_dirs": [
    "build/",
    "target/"
  ],
  "exts": [
    ".java"
  ],
  "comment": "//",
  "block_comments": [["/*", "*/"]],
  "rules": [
    {
      "kind": "type",
      "pattern": "(?m)^[ \\t]*public\\s+(?:static\\s+)?(?:final\\s+)?(class|interface|enum|record)\\s+([A-Za-z_][\\w]*)",
      "name_group": 2
    },
    {
      "kind": "func",
      "pattern": "(?m)^[ \\t]*public\\s+(?:static\\s+)?(?:final\\s+)?[\\w.<>,\\[\\]\\s]+\\s+([A-Z][\\w]*)\\s*\\(([^)]*)\\)",
      "name_group": 1,
      "params_group": 2
    }
  ],
  "imposed_names": [
    "toString",
    "equals",
    "hashCode",
    "clone",
    "finalize",
    "compareTo",
    "run",
    "call",
    "close",
    "iterator",
    "get",
    "set",
    "accept",
    "apply",
    "test"
  ],
  "imports": [
    {
      "kind": "import",
      "pattern": "(?m)^[ \\t]*import[ \\t]+(?:static[ \\t]+)?([\\w.*]+)[ \\t]*;",
      "name_group": 1
    }
  ]
}
