{
  "id": "go",
  "test_files": [
    "*_test.go"
  ],
  "unit_manifests": [
    "go.mod"
  ],
  "test_runner": "go test -v -timeout={timeout} {pkg}",
  "test_run_filter": "-run {name}",
  "timeout_flag": "-timeout={timeout}",
  "test_selector": "package-dir",
  "result_parser": "json-events",
  "result_fail_pattern": "(?m)^\\s*--- FAIL: (\\S+)",
  "test_name_rule": "^(Test|Benchmark|Fuzz)([^a-z]|$)",
  "test_decl_pattern": "(?m)^func {name}\\(\\s*\\w+\\s+\\*testing\\.[TB]\\s*\\)",
  "formatter": {"check": "gofmt", "args": ["-l"], "expected_exit": 0},
  "race_flag": "-race",
  "test_command_pattern": "go test\\s+(\\./\\S+)",
  "verify_commands": ["go test", "gofmt", "go vet", "go build"],
  "test_skip_dirs": [".git", "node_modules", "vendor", ".sandbox", ".orch", "third_party"],
  "test_ast_engine": "go-ast",
  "exts": [
    ".go"
  ],
  "comment": "//",
  "block_comments": [["/*", "*/"]],
  "engine": "go-ast",
  "skip_env_words": [
    "network",
    "internet",
    "display"
  ],
  "skip_env_tools": [
    "bash",
    "sh",
    "git",
    "gcc",
    "cc",
    "clang",
    "make",
    "cmake",
    "node",
    "npm",
    "python",
    "python3",
    "java",
    "dotnet",
    "docker"
  ],
  "imposed_names": [
    "Error",
    "String",
    "Read",
    "Write",
    "Close",
    "ServeHTTP",
    "RoundTrip",
    "MarshalJSON",
    "UnmarshalJSON",
    "MarshalText",
    "UnmarshalText",
    "Len",
    "Less",
    "Swap",
    "Next",
    "Scan",
    "Value",
    "Unwrap",
    "Is",
    "As",
    "Format",
    "GoString",
    "Seek",
    "Flush",
    "Reset",
    "Done",
    "Deadline",
    "Err"
  ],
  "imports": [
    {
      "kind": "import",
      "pattern": "(?m)^[ \\t]*import[ \\t]+(?:[\\w.]+[ \\t]+)?(\"[^\"\\n]+\")",
      "name_group": 1
    },
    {
      "kind": "import",
      "pattern": "(?ms)^import[ \\t]*\\(([^)]*)\\)",
      "name_group": 1
    }
  ]
}
