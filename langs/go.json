{
  "id": "go",
  "test_files": [
    "*_test.go"
  ],
  "unit_manifests": [
    "go.mod"
  ],
  "exts": [
    ".go"
  ],
  "comment": "//",
  "block_comments": [["/*", "*/"]],
  "engine": "go-ast",
  "skip_env_words": [
    "network",
    "internet",
    "display"
  ],
  "skip_env_tools": [
    "bash",
    "sh",
    "git",
    "gcc",
    "cc",
    "clang",
    "make",
    "cmake",
    "node",
    "npm",
    "python",
    "python3",
    "java",
    "dotnet",
    "docker"
  ],
  "imposed_names": [
    "Error",
    "String",
    "Read",
    "Write",
    "Close",
    "ServeHTTP",
    "MarshalJSON",
    "UnmarshalJSON",
    "MarshalText",
    "UnmarshalText",
    "Len",
    "Less",
    "Swap",
    "Next",
    "Scan",
    "Value",
    "Unwrap",
    "Is",
    "As",
    "Format",
    "GoString",
    "Seek",
    "Flush",
    "Reset",
    "Done",
    "Deadline",
    "Err"
  ],
  "imports": [
    {
      "kind": "import",
      "pattern": "(?m)^[ \\t]*import[ \\t]+(?:[\\w.]+[ \\t]+)?(\"[^\"\\n]+\")",
      "name_group": 1
    },
    {
      "kind": "import",
      "pattern": "(?ms)^import[ \\t]*\\(([^)]*)\\)",
      "name_group": 1
    }
  ]
}
