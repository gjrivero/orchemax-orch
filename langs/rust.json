{
  "id": "rust",
  "exts": [
    ".rs"
  ],
  "comment": "//",
  "aliases": [
    "rs"
  ],
  "rules": [
    {
      "kind": "func",
      "pattern": "(?m)^[ \\t]*pub(?:\\s*\\([^)]*\\))?\\s+(?:async\\s+)?fn\\s+([A-Za-z_][\\w]*)\\s*(?:<[^>]*>)?\\s*\\(([^)]*)\\)",
      "name_group": 1,
      "params_group": 2
    },
    {
      "kind": "type",
      "pattern": "(?m)^[ \\t]*pub(?:\\s*\\([^)]*\\))?\\s+(struct|enum|trait|type)\\s+([A-Za-z_][\\w]*)",
      "name_group": 2
    },
    {
      "kind": "const",
      "pattern": "(?m)^[ \\t]*pub(?:\\s*\\([^)]*\\))?\\s+(?:const|static)\\s+([A-Za-z_][\\w]*)",
      "name_group": 1
    }
  ],
  "imposed_names": [
    "new",
    "fmt",
    "drop",
    "next",
    "from",
    "into",
    "default",
    "clone",
    "eq",
    "hash"
  ]
}
