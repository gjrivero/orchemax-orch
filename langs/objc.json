{
  "id": "objc",
  "exts": [".m", ".mm"],
  "comment": "//",
  "aliases": ["objective-c", "objectivec"],
  "rules": [
    {"kind": "type", "pattern": "(?m)^@interface\\s+([A-Za-z_][\\w]*)", "name_group": 1},
    {"kind": "type", "pattern": "(?m)^@implementation\\s+([A-Za-z_][\\w]*)", "name_group": 1},
    {"kind": "func", "pattern": "(?m)^[ \\t]*[-+]\\s*\\([^)]+\\)\\s*([A-Za-z_][\\w]*)", "name_group": 1}
  ]
}
