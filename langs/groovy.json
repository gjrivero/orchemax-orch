{
  "id": "groovy",
  "exts": [".groovy", ".gradle"],
  "comment": "//",
  "rules": [
    {"kind": "type", "pattern": "(?m)^[ \\t]*(?:public\\s+|private\\s+|protected\\s+)?(?:abstract\\s+)?class\\s+([A-Za-z_][\\w]*)", "name_group": 1},
    {"kind": "func", "pattern": "(?m)^[ \\t]*(?:public\\s+|private\\s+|protected\\s+|static\\s+)*def\\s+([A-Za-z_][\\w]*)\\s*\\(([^)]*)\\)", "name_group": 1, "params_group": 2}
  ]
}
